/docs/
objdiff.json
.agents
.codex
/assets
# Language initializer headers are build inputs; local manifests stay ignored.
/src/lang/*
!/src/lang/jp/
/src/lang/jp/*
!/src/lang/jp/*.h
/src/nonmatching
AGENTS.md
/tools/gpba
